{
  "name": "dsh-sooyo",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "author": "CaiZongyuan",
  "description": "sooyo daily —— DSH 个人空间：把多个信息源聚合成一个小组件式主页，每个源有自己的卡片形态 | A widget-style personal homepage for DeepSeek Harness",
  "homepage": "https://github.com/CaiZongyuan/dsh-sooyo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaiZongyuan/dsh-sooyo.git"
  },
  "bugs": {
    "url": "https://github.com/CaiZongyuan/dsh-sooyo/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "homepage",
    "personal-homepage",
    "workspace",
    "dashboard",
    "widget",
    "rss",
    "aihot"
  ],
  "icon": "./icon.svg",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "icon.svg",
    "assets",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "GLOSSARY.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node dev/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check": "node --check index.js && node --check client.js && node dev/check-imports.mjs",
    "test": "node dev/selftest.mjs",
    "test:offline": "node dev/selftest.mjs --offline",
    "test:e2e": "playwright test",
    "prepack": "pnpm run typecheck && pnpm run build && pnpm run check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
